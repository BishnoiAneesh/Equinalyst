# ---- Postgres ----
POSTGRES_USER=valuation
POSTGRES_PASSWORD=valuation
POSTGRES_DB=valuation
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://valuation:valuation@db:5432/valuation

# ---- Redis / Celery ----
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- Auth ----
JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Screener.in scraping ----
SCREENER_BASE_URL=https://www.screener.in
SCRAPE_DELAY_SECONDS=2
SCRAPE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36

# ---- Local storage (no cloud) ----
EXPORTS_DIR=/app/data/exports

# ---- App ----
APP_ENV=local
LOG_LEVEL=INFO
